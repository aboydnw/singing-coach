# systemd unit for singing-coach. Adjust User and the paths, then:
#
#   sudo cp deploy/singing-coach.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now singing-coach
#   journalctl -u singing-coach -f
#
# Binds loopback on purpose: Caddy terminates TLS and proxies to it. Nothing
# should reach the app except through the proxy.

[Unit]
Description=singing-coach
Documentation=https://github.com/aboydnw/singing-coach
After=network-online.target ollama.service
Wants=network-online.target

[Service]
Type=simple
User=anthony
WorkingDirectory=/home/anthony/projects/singing-coach

Environment=SINGING_COACH_HOST=127.0.0.1
Environment=SINGING_COACH_PORT=7860

ExecStart=/home/anthony/projects/singing-coach/.venv/bin/python -m singing_coach.app

Restart=on-failure
RestartSec=5s

# The app needs its own data directory and the torch model cache.
ProtectSystem=full
PrivateTmp=false
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
