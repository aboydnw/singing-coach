# Caddy in front of singing-coach. Replace the hostname with your own.
#
# Two lines here are load-bearing:
#
# basic_auth gates the whole site. The app has no access control of its own —
# signing in controls Supabase sync, not entry — so without this, anyone with
# the URL can record, spend the host's CPU on a coaching call, and read whatever
# the signed-in account can see.
#
# flush_interval -1 disables response buffering. Gradio delivers every event
# result over a long-lived SSE stream (/gradio_api/queue/data). A proxy that
# buffers holds those events until the buffer fills, so the browser sits on a
# spinner while the server has already answered. This is the same failure mode
# as tunnelling the app through editor port-forwarding.

sing.example.com {
	encode zstd gzip

	# Credentials come from the environment so no hash lands in git. Generate with:
	#   caddy hash-password --plaintext 'your-password'
	basic_auth {
		{$AUTH_USER} {$AUTH_PASSWORD_HASH}
	}

	request_body {
		max_size 100MB
	}

	reverse_proxy 127.0.0.1:7860 {
		flush_interval -1

		# Analysis can take a while on CPU-only hardware: pitch detection plus a
		# local coaching call. Don't cut the response off mid-think.
		transport http {
			read_timeout 15m
			write_timeout 15m
		}
	}
}
