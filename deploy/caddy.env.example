# Credentials for the basic_auth block in deploy/Caddyfile.
#
# Copy to /etc/caddy/caddy.env (root-owned, mode 0600 — the hash is not secret
# but there is no reason to publish it), then make Caddy read it:
#
#   sudo systemctl edit caddy
#
# and add:
#
#   [Service]
#   EnvironmentFile=/etc/caddy/caddy.env
#
# Generate the hash with:
#
#   caddy hash-password --plaintext 'your-password'
#
# Then restart Caddy — `systemctl edit` alone does not, and the running process
# keeps serving without the password until it does:
#
#   sudo systemctl restart caddy
#
# The hash is single-quoted for readability only. EnvironmentFile= takes values
# literally, so the $ characters in a bcrypt hash survive either way.

AUTH_USER=singer
AUTH_PASSWORD_HASH='$2a$14$replace.this.with.the.output.of.caddy.hash-password'
