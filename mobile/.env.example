# Public client configuration only. Use an approved HTTPS backend origin.
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_SUPABASE_URL=
# A publishable key or legacy anon-role key. Never a service_role/secret key.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Enable only after configuring singingcoach://auth/callback in Supabase.
EXPO_PUBLIC_GOOGLE_AUTH_ENABLED=false
# Leave unset for release builds; defaults to com.anthonynboyd.singingcoach.
# Alternate values are only for isolated build checks and rejected by EAS beta.
IOS_BUNDLE_IDENTIFIER=
# Confirm the existing Expo project ID before using EAS:
EAS_PROJECT_ID=
