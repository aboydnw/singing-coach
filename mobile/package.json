{
  "name": "singing-coach-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "packageManager": "yarn@4.13.0",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json}\"",
    "verify": "yarn format:check && yarn typecheck && yarn test",
    "export:ios": "expo export --platform ios"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "expo": "58.0.23",
    "expo-asset": "~58.0.20",
    "expo-audio": "~58.0.11",
    "expo-auth-session": "~58.0.17",
    "expo-crypto": "~58.0.7",
    "expo-file-system": "~58.0.13",
    "expo-linking": "~58.0.16",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-url-polyfill": "2.0.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "^19.1.0",
    "prettier": "3.6.2",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3",
    "vitest": "3.2.4"
  }
}
