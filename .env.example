# Copy this file to `.env` and fill in whatever you need. Everything here is optional:
# out of the box, coaching runs locally through Ollama and nothing is synced.

# Coaching backend: `ollama` (local, free) or `anthropic` (API, paid).
SINGING_COACH_BACKEND=ollama
SINGING_COACH_OLLAMA_MODEL=qwen2.5:3b

# Only needed when SINGING_COACH_BACKEND=anthropic.
# Get a key at https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...

# Backup and multi-device sync. Leave unset to keep everything on this machine.
# Run supabase/migrations/0001_init.sql against the project first.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=...
