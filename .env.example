# Copy to `.env.local` for `yarn dev`. On Vercel, set the same names as
# project environment variables.

# --- Browser (public) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=...

# --- /api/analyze (Python function) ---
SUPABASE_URL=https://your-project.supabase.co
# Service role key: Supabase dashboard -> Settings -> API. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=...

# --- /api/coach (OpenRouter) ---
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...
# Any OpenRouter model id that supports structured_outputs.
COACH_MODEL=...
